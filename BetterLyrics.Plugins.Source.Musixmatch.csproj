<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<EnableDynamicLoading>true</EnableDynamicLoading>
		<Description>Adds Musixmatch as a lyrics source</Description>
		<RepositoryUrl>https://github.com/NimiGames68/Musixmatch-BetterLyrics</RepositoryUrl>
		<Version>1.0.0</Version>
		<Authors>NimiGames68</Authors>
		<Company>$(NimiGames68)</Company>
		<Copyright>Copyright © 2026 $(NimiGames68)</Copyright>
	</PropertyGroup>

	<PropertyGroup>
		<BetterLyricsHostDir>C:\Users\HP\Projects\BetterLyrics\src\BetterLyrics.DotNet</BetterLyricsHostDir>
	</PropertyGroup>

	<ItemGroup>
		<None Update="Langs\*.json">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
	</ItemGroup>

<Target Name="OverrideBetterLyricsLangs" AfterTargets="RunBetterLyricsDevTools">
    <ItemGroup>
        <BlpFile Include="$(ProjectDir)Dist\*.blp" />
    </ItemGroup>
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(ProjectDir)fix-langs.ps1&quot; -BlpPath &quot;%(BlpFile.FullPath)&quot; -OverrideDir &quot;$(ProjectDir)LangsOverride&quot;"
          Condition="'@(BlpFile)' != ''" />
</Target>

	<ItemGroup>
		<PackageReference Include="BetterLyrics.DevTools" Version="1.0.1" />
		<PackageReference Include="BetterLyrics.Sdk" Version="1.0.0" />
	</ItemGroup>

</Project>
